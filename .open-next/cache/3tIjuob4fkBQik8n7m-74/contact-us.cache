nce=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/0a1gboz92241g.js\"/><script src=\"/_next/static/chunks/27jktro2p5rq9.js\" async=\"\"></script><script src=\"/_next/static/chunks/3gzxhq9iq6efl.js\" async=\"\"></script><script src=\"/_next/static/chunks/29194twgvgfhb.js\" async=\"\"></script><script src=\"/_next/static/chunks/turbopack-2s116gu-ckzht.js\" async=\"\"></script><script src=\"/_next/static/chunks/05-c3ty_6dwfk.js\" async=\"\"></script><script src=\"/_next/static/chunks/14mrh2-p_w84d.js\" async=\"\"></script><script src=\"/_next/static/chunks/1td_9romeo9jm.js\" async=\"\"></script><script src=\"/_next/static/chunks/00b14b4qrervp.js\" async=\"\"></script><meta name=\"next-size-adjust\" content=\"\"/><title>My App</title><meta name=\"description\" content=\"Simple starter app.\"/><link rel=\"icon\" href=\"/favicon.png\" type=\"image/png\"/><script src=\"/_next/static/chunks/0cz1d0mv5g_q7.js\" noModule=\"\"></script></head><body class=\"min-h-screen bg-transparent\"><div hidden=\"\"><!--$--><!--/$--></div><header class=\"header\"><div class=\"corner-light\"></div><div class=\"corner-dark\"></div><div class=\"header-top\"><div class=\"logo-section\"><img alt=\"KODY Works Logo\" width=\"280\" height=\"280\" decoding=\"async\" data-nimg=\"1\" class=\"logo-image-header\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2F_next%2Fstatic%2Fmedia%2Flogo.3axgscm0vtymo.jpeg&amp;w=384&amp;q=75 1x, /_next/image?url=%2F_next%2Fstatic%2Fmedia%2Flogo.3axgscm0vtymo.jpeg&amp;w=640&amp;q=75 2x\" src=\"/_next/image?url=%2F_next%2Fstatic%2Fmedia%2Flogo.3axgscm0vtymo.jpeg&amp;w=640&amp;q=75\"/></div><div class=\"company-section\"><h1 class=\"company-name\"><span class=\"dark\">KODY</span><span class=\"blue\">Works</span></h1><div class=\"consulting-row\"><div class=\"line-one\"></div><h2>CONSULTING</h2><div class=\"line-one\"></div></div><div class=\"consulting-row\"><div class=\"line-two\"></div><p class=\"tagline\">Delivering Technology Solutions Worldwide</p><div class=\"line-two\"></div></div></div><button class=\"mobile-menu-toggle\" aria-label=\"Toggle menu\">☰</button></div><nav class=\"header-nav  \"><ul class=\"nav-list\"><li class=\"nav-item has-dropdown\"><button class=\"nav-link dropdown-toggle\">Home<span class=\"dropdown-arrow\">▼</span></button><ul class=\"dropdown-menu \"><li><a class=\"dropdown-link\" href=\"/\"><span class=\"dropdown-label\">Home 1 (Classic)</span><span class=\"dropdown-desc\">Classic white background layout with services grid</span></a></li><li><a class=\"dropdown-link\" href=\"/index2\"><span class=\"dropdown-label\">Home 2 (Animated)</span><span class=\"dropdown-desc\">Animated banner with blue gradient design</span></a></li><li><a class=\"dropdown-link\" href=\"/index3\"><span class=\"dropdown-label\">Home 3 (Green Theme)</span><span class=\"dropdown-desc\">Green animated banner with modern layout</span></a></li></ul></li><li class=\"nav-item has-dropdown\"><button class=\"nav-link dropdown-toggle\">Services<span class=\"dropdown-arrow\">▼</span></button><ul class=\"dropdown-menu \"><li><a class=\"dropdown-link\" href=\"/services/web-development\"><span class=\"dropdown-label\">Web Development</span><span class=\"dropdown-desc\">We specialize in crafting tailored web solutions, leveraging modern technologies and intuitive designs to deliver seamless, user-centric digital experiences.</span></a></li><li><a class=\"dropdown-link\" href=\"/services/generative-ai\"><span class=\"dropdown-label\">Generative AI</span><span class=\"dropdown-desc\">AI isn&#x27;t just for tech giants—it&#x27;s for you. We use it to automate, analyze, and enhance your business.</span></a></li><li><a class=\"dropdown-link\" href=\"/services/sap\"><span class=\"dropdown-label\">SAP</span><span class=\"dropdown-desc\">Transform enterprise operations with tailored SAP solutions, integrating modules across industries to streamline processes, enhance efficiency, and drive growth.</span></a></li><li><a class=\"dropdown-link\" href=\"/services/mobile-app-development\"><span class=\"dropdown-label\">Mobile Development</span><span class=\"dropdown-desc\">An app can make your business stand out. We create ones that engage users, strengthen your brand, and drive results.</span></a></li><li><a class=\"dropdown-link\" href=\"/services/mvp-development\"><span class=\"dropdown-label\">MVP</span><span class=\"dropdown-desc\">Launch a functional prototype quickly to gather real-world feedback, refine your product, and attract investors.</span></a></li><li><a class=\"dropdown-link\" href=\"/services/staffing\"><span class=\"dropdown-label\">Staffing</span><span class=\"dropdown-desc\">Need talent fast? Our IT pros jump in to deliver results without the hiring headache.</span></a></li><li><a class=\"dropdown-link\" href=\"/services/cloud-devops-integrations\"><span class=\"dropdown-label\">Cloud, DevOps &amp; Custom Integrations</span><span class=\"dropdown-desc\">The cloud makes your business agile, cost-effective, and connected. We simplify the switch so you can reap the rewards.</span></a></li><li><a class=\"dropdown-link\" href=\"/services/salesforce\"><span class=\"dropdown-label\">Salesforce</span><span class=\"dropdown-desc\">Unlock the full potential of your CRM with our expert Salesforce consulting, seamless implementation, and comprehensive support services.</span></a></li></ul></li><li class=\"nav-item has-dropdown\"><button class=\"nav-link dropdown-toggle\">About Chase<span class=\"dropdown-arrow\">▼</span></button><ul class=\"dropdown-menu \"><li><a class=\"dropdown-link\" href=\"/about/who-we-are\"><span class=\"dropdown-label\">Who We Are</span><span class=\"dropdown-desc\">Get your bearings on our values, culture, and unique approach.</span></a></li><li><a class=\"dropdown-link\" href=\"/about/life-at-american-chase\"><span class=\"dropdown-label\">Life At KODY Works</span><span class=\"dropdown-desc\">Join a team of passionate innovators reimagining the future of work.</span></a></li><li><a class=\"dropdown-link\" href=\"/about/jobs-at-american-chase\"><span class=\"dropdown-label\">Jobs At KODY Works</span><span class=\"dropdown-desc\">Explore opportunities that inspire, challenge, and unlock your potential.</span></a></li></ul></li><li class=\"nav-item has-dropdown\"><button class=\"nav-link dropdown-toggle\">Insights<span class=\"dropdown-arrow\">▼</span></button><ul class=\"dropdown-menu \"><li><a class=\"dropdown-link\" href=\"/insights/case-studies\"><span class=\"dropdown-label\">Case Studies</span><span class=\"dropdown-desc\">Explore real-world examples of our solutions in action.</span></a></li><li><a class=\"dropdown-link\" href=\"/insights/blogs\"><span class=\"dropdown-label\">Blogs</span><span class=\"dropdown-desc\">Indelible insights and perspectives from our thought leaders on the front lines.</span></a></li></ul></li><li class=\"nav-item \"><a class=\"nav-link\" href=\"/index2\">Showcase</a></li><li class=\"nav-item \"><a class=\"nav-link\" href=\"/contact-us\">Contact Us</a></li></ul></nav></header><main class=\"flex-1\"><div class=\"page-container\"><div class=\"page-header\"><h1>Contact Us</h1><p>We&#x27;d love to hear from you. Reach out and let&#x27;s start a conversation.</p></div><section id=\"contact\" class=\"contact-section\"><div class=\"section-title\"><span class=\"line\"></span><h2>CONTACT US</h2><span class=\"line\"></span></div><p class=\"contact-subtitle\">Ready to take your project to the next level? Get in touch with us today and let&#x27;s start building something amazing together.</p><div class=\"contact-grid\"><div class=\"contact-info\"><div class=\"contact-item\"><div class=\"contact-icon\"><svg stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" viewBox=\"0 0 512 512\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M493.4 24.6l-104-24c-11.3-2.6-22.9 3.3-27.5 13.9l-48 112c-4.2 9.8-1.4 21.3 6.9 28l60.6 49.6c-36 76.